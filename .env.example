# Optional. Without this key, the assistant uses local retrieval responses.
DEEPSEEK_API_KEY=
# Optional. Set true to develop and test the grounded local answer path without contacting an external model.
AGENT_LOCAL_ONLY=false

# In-site administrator. Change the password before deploying publicly.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Defaults to 50 failed attempts per IP within ten minutes.
ADMIN_LOGIN_MAX_ATTEMPTS=50

# Persistent content file. If blank, defaults to .content/content.json in the project.
# Production recommendation:
# CONTENT_STORE_PATH=/var/lib/sh-crafted/content.json
CONTENT_STORE_PATH=

# Primary SQLite persistence. In production, point this at a durable volume outside the Git checkout.
# CONTENT_DB_PATH=/var/lib/sh-crafted/content.db
CONTENT_DB_PATH=

# Administrator-uploaded step screenshots. Defaults to an uploads directory beside CONTENT_DB_PATH.
# CONTENT_UPLOAD_DIR=/var/lib/sh-crafted/uploads
CONTENT_UPLOAD_DIR=

# Engagement counters and community submissions. Keep it outside the Git checkout in production.
# COMMUNITY_STORE_PATH=/var/lib/sh-crafted/community.json
COMMUNITY_STORE_PATH=

# Set true behind production HTTPS. The deployment template already uses HTTPS.
ADMIN_COOKIE_SECURE=false

# Voice configuration is intentionally non-secret. Wake mode remains disabled
# in the browser until the visitor explicitly enables it.
VOICE_WAKE_WORDS=小蕉小蕉

# Local FunASR speech-to-text. The browser connects only to this site's same-origin gateway.
VOICE_STT_PROVIDER=funasr-local
VOICE_FUNASR_WS_URL=ws://127.0.0.1:10095
VOICE_ALLOWED_ORIGIN=
VOICE_SESSION_TTL_SECONDS=300
VOICE_MAX_SESSIONS_PER_IP=2
VOICE_BIND_SESSION_IP=false
VOICE_MAX_CONNECTIONS_PER_IP=1
VOICE_MAX_DURATION_SECONDS=30
VOICE_MAX_AUDIO_BYTES=4000000
VOICE_FUNASR_CONNECT_TIMEOUT_MS=3000
VOICE_FUNASR_FINAL_TIMEOUT_MS=5000
VOICE_FUNASR_CHUNK_SIZE=5,10,5
VOICE_FUNASR_CHUNK_INTERVAL=10
