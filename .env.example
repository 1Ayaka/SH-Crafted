# Optional. Without this key, the assistant uses local retrieval responses.
DEEPSEEK_API_KEY=

# In-site administrator. Change the password before deploying publicly.
ADMIN_USERNAME=djt
ADMIN_PASSWORD=12345689
# Defaults to 50 failed attempts per IP within ten minutes.
ADMIN_LOGIN_MAX_ATTEMPTS=50

# Persistent content file. If blank, defaults to .content/content.json in the project.
# Production recommendation:
# CONTENT_STORE_PATH=/var/lib/sh-crafted/content.json
CONTENT_STORE_PATH=

# Engagement counters and community submissions. Keep it outside the Git checkout in production.
# COMMUNITY_STORE_PATH=/var/lib/sh-crafted/community.json
COMMUNITY_STORE_PATH=

# Set true behind production HTTPS. The deployment template already uses HTTPS.
ADMIN_COOKIE_SECURE=false
