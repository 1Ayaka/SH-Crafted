server {
    listen 80;
    listen [::]:80;
    server_name avonana.site www.avonana.site;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/javascript application/xml image/svg+xml;

    # Let Nginx stream public assets directly. This avoids routing every large
    # GLB through Node, supports byte ranges/resume, and keeps repeat visits in
    # the browser cache. Source code/data keep a short cache so Git deployments
    # become visible quickly; heavyweight media use the server's versioned URL.
    location ^~ /assets/ {
        root /var/www/sh-crafted;
        try_files $uri =404;
        sendfile on;
        tcp_nopush on;
        add_header Cache-Control "public, max-age=604800, stale-while-revalidate=2592000" always;
        add_header X-Content-Type-Options nosniff always;
        access_log off;
    }

    location ~ ^/(css|js|vendor|data)/ {
        root /var/www/sh-crafted;
        try_files $uri =404;
        sendfile on;
        add_header Cache-Control "public, max-age=3600, must-revalidate" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Same-origin voice gateway. The browser connects here with WSS; Node
    # forwards the PCM stream to FunASR on 127.0.0.1:10095.
    location /api/voice/stream {
        proxy_pass http://127.0.0.1:7100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 45s;
        proxy_send_timeout 45s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:7100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 40s;
        proxy_buffering on;
    }
}
